	/// Prénom et nom du client.
	column 'Nom complet' = dim_customers[first_name] & " " & dim_customers[last_name]
		dataType: string
		lineageTag: c4faf353-dea2-4df5-af51-b7a9c4a20d8d
		summarizeBy: none

	/// Âge révolu du client à la date du jour.
	column Âge =
			IF(
			    ISBLANK(dim_customers[birthdate]),
			    BLANK(),
			    DATEDIFF(dim_customers[birthdate], TODAY(), YEAR)
			        - IF(
			            DATE(YEAR(TODAY()), MONTH(dim_customers[birthdate]), DAY(dim_customers[birthdate])) > TODAY(),
			            1,
			            0
			        )
			)
		dataType: int64
		formatString: 0
		lineageTag: 1c4dd564-4d85-4fa4-b6a0-cc3fc725fa7f
		summarizeBy: none

	/// Tranche d'âge du client, triée par ordre croissant via 'Tranche d'âge (ordre)'.
	column 'Tranche d''âge' =
			VAR _age = dim_customers[Âge]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(_age), "n/a",
			        _age < 30, "< 30 ans",
			        _age < 40, "30-39 ans",
			        _age < 50, "40-49 ans",
			        _age < 60, "50-59 ans",
			        _age < 70, "60-69 ans",
			        "70 ans et +"
			    )
		dataType: string
		lineageTag: ccf77107-104e-4b2f-a619-43cab569ab37
		summarizeBy: none
		sortByColumn: 'Tranche d''âge (ordre)'

	column 'Tranche d''âge (ordre)' =
			VAR _age = dim_customers[Âge]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(_age), 99,
			        _age < 30, 1,
			        _age < 40, 2,
			        _age < 50, 3,
			        _age < 60, 4,
			        _age < 70, 5,
			        6
			    )
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 9230f447-fa2f-43ec-a30c-6c99e6665818
		summarizeBy: none

	partition dim_customers = m
		mode: import
		source =
				let
				  Source = Sql.Database(".\SQLEXPRESS", "DataWarehouse", [Query = "SELECT * FROM gold.dim_customers"])
				in
				  Source

	annotation PBI_ResultType = Table

